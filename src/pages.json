{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/index",
      "style": { "navigationBarTitleText": "企业智造", "navigationStyle": "custom" }
    },
    {
      "path": "pages/dashboard/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/workbench/index",
      "style": { "navigationBarTitleText": "工作台", "navigationStyle": "custom" }
    },
    {
      "path": "pages/scan/index",
      "style": { "navigationBarTitleText": "扫码", "navigationStyle": "custom" }
    },
    {
      "path": "pages/messages/index",
      "style": { "navigationBarTitleText": "消息中心", "navigationStyle": "custom" }
    },
    {
      "path": "pages/profile/index",
      "style": { "navigationBarTitleText": "我的", "navigationStyle": "custom" }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "企业智造 MES",
    "navigationBarBackgroundColor": "#102a43",
    "backgroundColor": "#f4f7f9",
    "backgroundTextStyle": "dark"
  }
}
