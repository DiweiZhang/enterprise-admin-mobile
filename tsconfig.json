{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "preserveValueImports": false,
    "importsNotUsedAsValues": "remove",
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["node", "vite/client", "@dcloudio/types", "wot-design-uni/global"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "components.d.ts",
    "node_modules/uni-echarts/src/global.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
